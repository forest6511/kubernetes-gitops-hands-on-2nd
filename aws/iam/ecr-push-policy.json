{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushToTodoRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:ap-northeast-1:123456789012:repository/todo-api",
        "arn:aws:ecr:ap-northeast-1:123456789012:repository/todo-frontend"
      ]
    }
  ]
}
